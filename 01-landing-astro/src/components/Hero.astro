---
---

<section class="hero section">
  <div class="container">
    <div class="hero__announce">
      <span class="badge">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><circle cx="6" cy="6" r="6"/></svg>
        <span>New — AI integration available</span>
      </span>
    </div>

    <h1 class="hero__title">
      <span>Manage projects with</span><br />
      <span class="hero__title--accent">total clarity</span>
    </h1>

    <p class="hero__subtitle">
      TaskFlow centralizes your team, automates task tracking, and gives you real-time visibility to deliver projects without chaos.
    </p>

    <div class="hero__cta">
      <a href="#pricing" class="btn btn--primary">
        <span>Start free — 14 days</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="#how-it-works" class="btn btn--ghost">Watch demo</a>
    </div>

    <p class="hero__social-proof">
      More than <strong>2,400 teams</strong> already trust TaskFlow — no credit card required
    </p>

    <div class="hero__preview" aria-label="TaskFlow dashboard preview">
      <div class="hero__preview-inner">
        <div class="mock-app" aria-hidden="true">
          <div class="mock-app__topbar">
            <span class="mock-dot mock-dot--red"></span>
            <span class="mock-dot mock-dot--yellow"></span>
            <span class="mock-dot mock-dot--green"></span>
            <span class="mock-app__title">TaskFlow — Sprint 24</span>
          </div>
          <div class="mock-board">
            <div class="mock-col">
              <div class="mock-col__head"><span>To do</span><span class="mock-count">4</span></div>
              <div class="mock-card"><span class="mock-tag mock-tag--purple">Design</span>Update onboarding flow</div>
              <div class="mock-card"><span class="mock-tag mock-tag--blue">Bug</span>Fix invoice export</div>
              <div class="mock-card"><span class="mock-tag mock-tag--purple">Design</span>New pricing page</div>
            </div>
            <div class="mock-col">
              <div class="mock-col__head"><span>In progress</span><span class="mock-count">3</span></div>
              <div class="mock-card mock-card--active">
                <span class="mock-tag mock-tag--green">Feature</span>AI task suggestions
                <div class="mock-progress"><span></span></div>
              </div>
              <div class="mock-card"><span class="mock-tag mock-tag--blue">Bug</span>Slack sync delay</div>
            </div>
            <div class="mock-col">
              <div class="mock-col__head"><span>Done</span><span class="mock-count">8</span></div>
              <div class="mock-card mock-card--done">✓ Q3 roadmap review</div>
              <div class="mock-card mock-card--done">✓ Team onboarding v2</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--space-2xl) + 80px);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 35% at 50% -5%, rgba(99, 102, 241, 0.09), transparent 70%);
    pointer-events: none;
  }

  .hero__announce { margin-bottom: var(--space-md); }

  .hero__title {
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 16ch;
    margin-inline: auto;
  }

  .hero__title--accent {
    background: linear-gradient(135deg, #818cf8, #6366f1 50%, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    margin-top: var(--space-md);
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 48ch;
    margin-inline: auto;
  }

  .hero__cta {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero__social-proof {
    margin-top: var(--space-md);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .hero__preview {
    margin-top: var(--space-xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: var(--shadow-card), var(--shadow-glow);
    position: relative;
  }

  .hero__preview::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99,102,241,0.5), transparent);
  }

  .hero__preview-inner { padding: var(--space-lg); }

  /* Mockup del producto — sustituye al screenshot real */
  .mock-app {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-align: left;
  }

  .mock-app__topbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .mock-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .mock-dot--red    { background: #f87171; }
  .mock-dot--yellow { background: #fbbf24; }
  .mock-dot--green  { background: #34d399; }

  .mock-app__title {
    margin-left: 0.6rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .mock-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
  }

  .mock-col {
    background: var(--color-surface);
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 260px;
  }

  .mock-col__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .mock-count {
    background: var(--color-surface-2);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    font-size: 0.7rem;
  }

  .mock-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.7rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mock-card--active { border-color: rgba(99, 102, 241, 0.4); }
  .mock-card--done   { color: var(--color-text-muted); text-decoration: line-through; opacity: 0.7; }

  .mock-tag {
    align-self: flex-start;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
  }

  .mock-tag--purple { background: rgba(167, 139, 250, 0.18); color: #c4b5fd; }
  .mock-tag--blue   { background: rgba(96, 165, 250, 0.18); color: #93c5fd; }
  .mock-tag--green  { background: rgba(52, 211, 153, 0.18); color: #6ee7b7; }

  .mock-progress {
    height: 4px;
    border-radius: 999px;
    background: var(--color-border);
    overflow: hidden;
  }

  .mock-progress span {
    display: block;
    width: 65%;
    height: 100%;
    background: var(--color-primary);
  }

  @media (max-width: 720px) {
    .mock-board { grid-template-columns: 1fr; }
    .mock-col { min-height: auto; }
  }

  @media (max-width: 600px) {
    .hero__cta { flex-direction: column; align-items: center; }
  }
</style>
