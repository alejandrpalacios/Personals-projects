---
const testimonials = [
  { initials: 'MG', color: '#6366f1',
    quote: '"We replaced three tools with TaskFlow. Our team finally has one place to see what\'s actually happening."',
    name: 'Marta Gil', role: 'Head of Product, Novaworks' },
  { initials: 'DK', color: '#a78bfa',
    quote: '"The AI automations alone saved us about six hours a week per project manager."',
    name: 'Daniel Kron', role: 'Operations Lead, Brightline' },
  { initials: 'SR', color: '#818cf8',
    quote: '"Setup took an afternoon. Client reporting that used to take a day now takes ten minutes."',
    name: 'Sofia Reyes', role: 'Founder, Alto Labs' },
];
---

<section class="testimonials section" id="testimonials">
  <div class="container">
    <div class="testimonials__header">
      <span class="section__label">Testimonials</span>
      <h2 class="section__title">Teams that ship faster with TaskFlow</h2>
      <p class="section__subtitle">Real feedback from teams who switched.</p>
    </div>

    <div class="testimonials__grid grid-3">
      {testimonials.map(t => (
        <figure class="card testimonial-card">
          <blockquote class="testimonial-card__quote">{t.quote}</blockquote>
          <figcaption class="testimonial-card__author">
            <span class="testimonial-card__avatar" style={`background:${t.color}`} aria-hidden="true">{t.initials}</span>
            <div>
              <p class="testimonial-card__name">{t.name}</p>
              <p class="testimonial-card__role">{t.role}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials__header { text-align: center; margin-bottom: var(--space-xl); }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .testimonial-card__quote {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .testimonial-card__author {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .testimonial-card__avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }

  .testimonial-card__name { font-size: 0.88rem; font-weight: 600; }
  .testimonial-card__role { font-size: 0.8rem; color: var(--color-text-muted); }
</style>
