---
// Footer global
const links = {
  Product: ['Features', 'Pricing', 'Changelog', 'Roadmap'],
  Resources: ['Documentation', 'Blog', 'Tutorials', 'System status'],
  Company: ['About us', 'Careers', 'Press', 'Contact'],
  Legal: ['Privacy', 'Terms', 'Cookies', 'Security'],
};
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <!-- Columna marca -->
      <div class="footer__brand">
        <a href={import.meta.env.BASE_URL} class="logo" aria-label="TaskFlow home">
          TaskFlow
        </a>
        <p class="footer__tagline">
          Manage projects with total clarity.
          Built for teams that deliver.
        </p>
      </div>

      <!-- Columnas de enlaces -->
      {Object.entries(links).map(([section, items]) => (
        <div class="footer__col">
          <h4 class="footer__col-title">{section}</h4>
          <ul role="list">
            {items.map(item => (
              <li>
                <a href="#" class="footer__link">{item}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <hr class="divider" />

    <div class="footer__bottom">
      <p>&copy; {new Date().getFullYear()} <span>TaskFlow Inc. All rights reserved.</span></p>
      <!-- Redes sociales — reemplazar hrefs -->
      <div class="footer__social" role="list" aria-label="Social media">
        <a href="#" aria-label="Twitter / X">𝕏</a>
        <a href="#" aria-label="LinkedIn">in</a>
        <a href="#" aria-label="GitHub">GH</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-xl) var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 2fr repeat(4, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .logo {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    margin-top: var(--space-sm);
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    white-space: pre-line;
  }

  .footer__col-title {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .footer__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__link {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    transition: color 200ms;
  }

  .footer__link:hover {
    color: var(--color-text);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-md);
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .footer__social {
    display: flex;
    gap: var(--space-md);
  }

  .footer__social a {
    color: var(--color-text-muted);
    transition: color 200ms;
    font-weight: 600;
  }

  .footer__social a:hover {
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 500px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
